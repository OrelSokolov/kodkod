# kodkod — the window/taskbar icon rasters, compile-time-embedded.
# 64×64 straight RGBA regenerated by `rake icons` from the same
# assets/kodkod.svg every other icon derives from. The art is
# monochrome, so it ships in two tints: the Win32 taskbar icon keeps
# the near-black one (matches the packaged .ico), while the caption
# slot (Egui::WindowFrame) re-tints with the theme — near-white art
# on the dark chrome and vice versa (see KodkodApp#update).

module Kodkod
  ICON_PX = 64

  ICON_DARK_ART  = {{ read_file(__DIR__ + "/../assets/icon_dark.rgba") }}
  ICON_LIGHT_ART = {{ read_file(__DIR__ + "/../assets/icon_light.rgba") }}

  def self.icon_rgba(light : Bool) : NamedTuple(rgba: Bytes, width: Int32,
                                                height: Int32)
    {rgba: (light ? ICON_LIGHT_ART : ICON_DARK_ART).to_slice,
     width: ICON_PX, height: ICON_PX}
  end
end
